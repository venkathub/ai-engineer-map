{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/venkathub/ai-engineer-map/blob/main/curriculum/hoe.schema.json",
  "title": "AI Engineer Map hands-on exercise catalog",
  "type": "object",
  "required": ["schemaVersion", "profiles", "topics"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mode", "status", "runner", "estimatedMinutes", "estimatedCost", "requirements", "artifacts", "cleanup"],
        "properties": {
          "mode": {"enum": ["browser", "local", "byo-api", "gpu"]},
          "status": {"enum": ["guided", "automated", "setup-ready"]},
          "runner": {"enum": ["guided", "command", "manual"]},
          "estimatedMinutes": {"type": "integer", "minimum": 1},
          "estimatedCost": {"type": "string", "minLength": 1},
          "requirements": {"type": "array", "items": {"type": "string"}},
          "setup": {"$ref": "#/$defs/command"},
          "run": {"$ref": "#/$defs/command"},
          "verify": {"$ref": "#/$defs/command"},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cleanup": {"type": "array", "items": {"type": "string"}},
          "provider": {"enum": ["none", "openai", "anthropic", "gemini", "openrouter", "compatible"]},
          "gpuBackend": {"enum": ["none", "local", "jarvislabs"]}
        },
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "command": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
