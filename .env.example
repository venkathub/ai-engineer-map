# Copy to .env and fill only the providers you use. Never commit .env.
# The static browser application never reads these values; terminal/Jupyter HOE runners do.

# Hosted model providers
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Any OpenAI-compatible local or remote endpoint (Ollama, vLLM, etc.)
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=

# JarvisLabs CLI automation. Prefer `jl setup` for interactive local use.
JL_API_KEY=
JARVISLABS_GPU=L4
JARVISLABS_STORAGE_GB=100

# Exercise outputs
HOE_OUTPUT_DIR=outputs
